# =============================================================================
# NOTEForge Environment Configuration Template (.env.example)
# Copy this file to .env and configure credentials for local development.
# Do NOT commit real credentials or .env files to version control.
# =============================================================================

# Flask Application Configuration
FLASK_ENV=development
SECRET_KEY=noteforge-change-me-to-a-secure-random-secret-key-in-prod
APP_VERSION=1.0.0-dev

# Docker Host Port Mappings
WEB_PORT=5000
DB_PORT=5432

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=noteforge_user
POSTGRES_PASSWORD=noteforge_dev_secure_password
POSTGRES_DB=noteforge

# Database Connection Variables (derived or supplied individually)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=noteforge
DATABASE_USER=noteforge_user
DATABASE_PASSWORD=noteforge_dev_secure_password

# Complete Database URL (optional override)
# In Docker: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://noteforge_user:noteforge_dev_secure_password@db:5432/noteforge
