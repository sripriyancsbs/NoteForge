# =============================================================================
# NOTEForge Environment Configuration Template (.env.example)
# Copy this file to .env and configure credentials for local development.
# Do NOT commit real credentials or .env files to version control.
# =============================================================================

# Flask Application Configuration
FLASK_ENV=development
SECRET_KEY=<your-secret-key-change-in-production>
APP_VERSION=1.0.0-dev

# Docker Host Port Mappings
WEB_PORT=5000
DB_PORT=5432

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=noteforge_user
POSTGRES_PASSWORD=<your-local-postgres-password>
POSTGRES_DB=noteforge

# Database Connection Variables (derived or supplied individually)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=noteforge
DATABASE_USER=noteforge_user
DATABASE_PASSWORD=<your-local-postgres-password>

# Complete Database URL (optional override)
# In Docker: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://<user>:<password>@db:5432/<database>

# -----------------------------------------------------------------------------
# Vercel Deployment (Serverless Public Target)
# Configure these variables in the Vercel Dashboard under Project Settings -> Environment Variables.
# Note: PostgreSQL must be an externally hosted instance (e.g., Neon, Supabase, AWS RDS, Render).
# Do NOT commit real production credentials to version control.
# -----------------------------------------------------------------------------
# FLASK_ENV=production
# SECRET_KEY=<your-production-secret-key>
# DATABASE_URL=postgresql://<user>:<password>@<hosted-postgres-host>:5432/<dbname>?sslmode=require
# APP_VERSION=1.0.0
